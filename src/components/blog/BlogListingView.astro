---
/**
 * Shared body for listings: /blog/, /category/…, /tag/… (all paginated WordPress-style).
 * Renders header, search, category filter, post grid (newest post featured on /blog/) and pagination.
 */
import PageHeader from '../ui/PageHeader.astro';
import Icon from '../ui/Icon.astro';
import PostCard from './PostCard.astro';
import PaginationNav from './PaginationNav.astro';
import BlogSearch from './BlogSearch.astro';
import { categoryUrl, type Category, type PostPage } from '../../lib/blog-posts';
import { escapeHtml } from '../../lib/escape-html';

interface Props {
  page: PostPage;
  title: string;
  lead: string;
  eyebrow: string;
  categories: (Category & { count: number })[];
  activeCategory?: string;
  featureFirst?: boolean;
}

const { page, title, lead, eyebrow, categories, activeCategory, featureFirst = false } = Astro.props;
const chip = 'inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm transition-colors';
const heading = page.currentPage > 1 ? `${title} – Page ${page.currentPage}` : title;
const [first, ...rest] = page.posts;
const showFeatured = featureFirst && page.currentPage === 1 && first;
---

<PageHeader eyebrow={eyebrow} title={escapeHtml(heading)} lead={lead}>
  <div class="mx-auto mt-8 max-w-xl text-left">
    <BlogSearch />
  </div>
</PageHeader>

<div class="container-page mt-10">
  <nav aria-label="Categories" class="flex flex-wrap items-center justify-center gap-2">
    <a
      href="/blog/"
      class:list={[chip, !activeCategory ? 'border-fg bg-fg text-bg' : 'border-line hover:border-line-strong']}
      aria-current={!activeCategory ? 'page' : undefined}
    >
      All posts
    </a>
    {
      categories.map((c) => (
        <a
          href={categoryUrl(c.path)}
          class:list={[chip, activeCategory === c.path ? 'border-fg bg-fg text-bg' : 'border-line hover:border-line-strong']}
          aria-current={activeCategory === c.path ? 'page' : undefined}
        >
          {c.name}
          <span class="ml-1.5 font-mono text-xs opacity-60">{c.count}</span>
        </a>
      ))
    }
  </nav>

  {showFeatured && <div class="mt-12"><PostCard post={first} featured /></div>}

  {
    page.posts.length > 0 ? (
      <ul class:list={['grid gap-6 sm:grid-cols-2 lg:grid-cols-3', showFeatured ? 'mt-6' : 'mt-12']}>
        {(showFeatured ? rest : page.posts).map((post) => (
          <li class="flex">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-16 text-center text-muted">No posts yet — check back soon.</p>
    )
  }

  <PaginationNav currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={page.baseUrl} />

  <p class="mt-14 text-center text-sm text-muted">
    <a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:text-fg">
      <Icon name="rss" size={15} />
      Subscribe via RSS
    </a>
  </p>
</div>
