---
/**
 * AI-powered campaigns. Facts: app has "Generate email subject / content / template"
 * and auto translation (modules/ai, translation) with auto language detection; Pro plan.
 */
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { aiFeatures } from '../../data/features';

const translations = [
  ['EN', 'Your cart misses you — 10% off inside'],
  ['DE', 'Dein Warenkorb vermisst dich – 10 % Rabatt'],
  ['FR', 'Votre panier vous attend : -10 % à l’intérieur'],
  ['ES', 'Tu carrito te extraña: 10 % de descuento'],
  ['JA', 'カートの商品が待っています — 10%オフ'],
];
---

<section id="ai" aria-labelledby="ai-title" class="scroll-mt-20 border-y border-line bg-surface py-24 sm:py-32">
  <div class="container-page grid items-center gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="min-w-0">
      <SectionHeading
        id="ai-title"
        eyebrow="AI-powered campaigns"
        title="From idea to a campaign that sells — in seconds."
        lead="Describe what you want to promote. Uppush AI drafts the subject line, the copy and the template, then translates it so every subscriber reads it in their own language."
      />
      <ul class="mt-10 space-y-5">
        {
          aiFeatures.map((f) => (
            <li class="flex gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-signal-soft text-accent">
                <Icon name={f.icon} size={19} />
              </span>
              <div>
                <h3 class="font-semibold tracking-tight">{f.title}</h3>
                <p class="mt-0.5 text-sm leading-relaxed text-muted">{f.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- AI composer scene -->
    <div class="relative min-w-0" role="img" aria-label="Example: AI generating an email subject and translating it into four languages">
      <div class="rounded-[1.25rem] border border-line bg-bg p-4 shadow-card sm:p-6" aria-hidden="true">
        <div class="rounded-xl border border-line bg-surface p-4">
          <p class="flex items-center gap-2 text-xs font-medium text-muted"><Icon name="wand" size={14} class="text-accent" /> Prompt</p>
          <p class="mt-2 text-sm">Win back shoppers who left their cart. Friendly tone, offer 10% off, mention free shipping.</p>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
            <span class="flex gap-1.5">
              {['Subject', 'Copy', 'Template'].map((t, i) => <span class:list={['chip', i === 0 ? 'chip-signal' : 'border border-line']}>{t}</span>)}
            </span>
            <span class="inline-flex h-8 items-center gap-1.5 rounded-full bg-fg px-3 text-xs font-semibold text-bg"><Icon name="sparkles" size={13} /> Generate</span>
          </div>
        </div>
        <div class="mt-3 rounded-xl border border-signal/50 bg-signal-soft/50 p-4">
          <p class="flex items-center justify-between text-xs">
            <span class="font-medium text-accent">AI suggestions</span>
            <span class="font-mono text-muted">3 variants</span>
          </p>
          <ul class="mt-2 space-y-1.5 text-sm">
            <li class="flex items-center gap-2 rounded-lg bg-surface px-3 py-2 font-medium"><Icon name="check" size={14} strokeWidth={2.5} class="text-accent" /> Your cart misses you — 10% off inside</li>
            <li class="rounded-lg px-3 py-2 text-muted">Still deciding? Free shipping + 10% off today</li>
            <li class="rounded-lg px-3 py-2 text-muted">We saved your cart (and a little surprise)</li>
          </ul>
        </div>
        <div class="mt-3 rounded-xl border border-line bg-surface p-4">
          <p class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-xs">
            <span class="flex items-center gap-1.5 font-medium"><Icon name="languages" size={14} class="text-accent" /> Auto translate</span>
            <span class="font-mono text-muted">detects each subscriber’s language</span>
          </p>
          <ul class="mt-2 space-y-1">
            {
              translations.slice(1).map(([lang, text]) => (
                <li class="flex items-center gap-3 rounded-md px-2 py-1.5 text-sm">
                  <span class="w-6 shrink-0 font-mono text-xs text-muted">{lang}</span>
                  <span class="min-w-0 truncate">{text}</span>
                  <Icon name="check" size={14} strokeWidth={2.5} class="ml-auto shrink-0 text-accent" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <span class="absolute -top-3 -right-3 hidden rounded-full bg-fg px-3 py-1.5 font-mono text-[0.6875rem] font-medium text-bg shadow-float sm:block" aria-hidden="true">
        100+ languages
      </span>
    </div>
  </div>
</section>
