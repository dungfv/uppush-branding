---
/** Campaigns bento: editor, A/B test, segments, revenue attribution. Sample data in mockups. */
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="campaigns" aria-labelledby="campaigns-title" class="container-page scroll-mt-20 py-20">
  <SectionHeading
    id="campaigns-title"
    eyebrow="Campaigns"
    title="Campaigns that go to the right people — and prove what they earned."
    lead="Design an email in minutes, send it to a segment that updates in real time, let an A/B test pick the winner, and see the revenue every send brought in."
    align="center"
  />

  <div class="mt-16 grid gap-4 lg:grid-cols-6">
    <!-- Editor -->
    <article class="flex flex-col overflow-hidden rounded-(--radius-card) border border-line bg-surface lg:col-span-4">
      <div class="p-6 sm:p-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <Icon name="layout" size={19} class="text-accent" /> Drag-and-drop email editor
        </h3>
        <p class="mt-2 max-w-md text-[0.9375rem] text-muted">
          Start from a pre-designed template, drop in products, discount codes and your logo, and save your own layouts for
          next time.
        </p>
      </div>
      <div class="mt-auto grid grid-cols-[8.5rem_1fr] gap-0 border-t border-line bg-bg sm:grid-cols-[10rem_1fr]" aria-hidden="true">
        <div class="space-y-2 border-r border-line p-3">
          {
            [
              ['layout', 'Header'],
              ['package', 'Products'],
              ['ticket', 'Discount'],
              ['send', 'Button'],
              ['users', 'Social'],
            ].map(([icon, label]) => (
              <div class="flex items-center gap-2 rounded-md border border-line bg-surface px-2 py-1.5 text-xs">
                <Icon name={icon as 'layout'} size={13} class="text-muted" />
                {label}
              </div>
            ))
          }
        </div>
        <div class="p-4 sm:p-6">
          <div class="mx-auto max-w-sm rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="mx-auto h-2.5 w-16 rounded bg-fg"></div>
            <p class="mt-4 text-center text-base leading-tight font-semibold">New season, new favourites</p>
            <div class="mt-3 grid grid-cols-3 gap-2">
              <div class="aspect-square rounded bg-gradient-to-br from-amber-100 to-orange-200"></div>
              <div class="aspect-square rounded bg-gradient-to-br from-emerald-100 to-teal-200 ring-2 ring-signal ring-offset-2 ring-offset-surface"></div>
              <div class="aspect-square rounded bg-gradient-to-br from-indigo-100 to-violet-200"></div>
            </div>
            <div class="mx-auto mt-3 h-8 w-32 rounded-full bg-signal"></div>
          </div>
        </div>
      </div>
    </article>

    <!-- A/B -->
    <article class="flex flex-col rounded-(--radius-card) border border-line bg-surface p-6 sm:p-8 lg:col-span-2">
      <h3 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <Icon name="split" size={19} class="text-accent" /> A/B testing
      </h3>
      <p class="mt-2 text-[0.9375rem] text-muted">
        Test two subjects, senders or designs on 2–90% of your list. The winner — by opens, clicks or revenue — goes to
        everyone else automatically.
      </p>
      <div class="mt-auto space-y-3 pt-6" aria-hidden="true">
        <div class="rounded-lg border border-line bg-bg p-3">
          <div class="flex items-center justify-between text-xs"><span class="font-mono text-muted">A · “Last chance: 20% off”</span><span class="num font-mono">24.1%</span></div>
          <div class="mt-2 h-1.5 rounded-full bg-line"><div class="h-full w-[48%] rounded-full bg-line-strong"></div></div>
        </div>
        <div class="rounded-lg border border-signal/60 bg-signal-soft/60 p-3">
          <div class="flex items-center justify-between text-xs"><span class="font-mono text-accent">B · “Your picks are 20% off”</span><span class="num font-mono font-semibold text-accent">31.8%</span></div>
          <div class="mt-2 h-1.5 rounded-full bg-line"><div class="h-full w-[64%] rounded-full bg-signal"></div></div>
          <p class="mt-2 flex items-center gap-1 text-[0.6875rem] font-medium text-accent"><Icon name="trophy" size={12} /> Winner · sent to the other 80%</p>
        </div>
      </div>
    </article>

    <!-- Segments -->
    <article class="flex flex-col rounded-(--radius-card) border border-line bg-surface p-6 sm:p-8 lg:col-span-3">
      <h3 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <Icon name="users" size={19} class="text-accent" /> Segments that update themselves
      </h3>
      <p class="mt-2 text-[0.9375rem] text-muted">
        Group subscribers by behaviour and attributes in Uppush, or send straight to a customer segment you already built
        in Shopify.
      </p>
      <ul class="mt-6 space-y-2" aria-hidden="true">
        {
          [
            ['Discount lovers', 'Used a discount code in the last 30 days', 'Uppush'],
            ['Abandoned checkout · 7 days', 'Started checkout, didn’t pay', 'Uppush'],
            ['VIP customers', 'Imported from Shopify admin', 'Shopify'],
          ].map(([name, rule, source]) => (
            <li class="flex items-center justify-between gap-3 rounded-lg border border-line bg-bg px-3 py-2.5">
              <span class="min-w-0">
                <span class="block text-sm font-medium">{name}</span>
                <span class="block truncate text-xs text-muted">{rule}</span>
              </span>
              <span class:list={['chip shrink-0', source === 'Shopify' ? 'chip-warn' : 'chip-signal']}>{source}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- Revenue -->
    <article class="flex flex-col rounded-(--radius-card) bg-ink p-6 text-on-ink sm:p-8 lg:col-span-3">
      <h3 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <Icon name="chart" size={19} class="text-signal" /> Revenue you can attribute
      </h3>
      <p class="mt-2 text-[0.9375rem] text-on-ink-muted">
        See orders and revenue generated by each campaign and automation, split by email and web push, next to revenue
        from other sources. UTM tags are added for you.
      </p>
      <div class="mt-auto pt-6" aria-hidden="true">
        <div class="flex h-28 items-end gap-1.5">
          {
            [38, 52, 44, 60, 48, 72, 66, 80, 70, 92, 84, 100].map((h, i) => (
              <div class="flex flex-1 flex-col justify-end gap-0.5" style={`height:${h}%`}>
                <div class="rounded-t-sm bg-signal" style={`height:${55 + (i % 3) * 8}%`} />
                <div class="rounded-b-sm bg-white/15" style={`height:${45 - (i % 3) * 8}%`} />
              </div>
            ))
          }
        </div>
        <p class="mt-3 flex gap-4 font-mono text-[0.6875rem] text-on-ink-muted">
          <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-sm bg-signal"></span>From Uppush</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-sm bg-white/25"></span>Other sources</span>
          <span class="ml-auto">Sample data</span>
        </p>
      </div>
    </article>
  </div>
</section>
