---
/** Thin band under the hero: verifiable numbers + the Shopify surfaces Uppush plugs into. */
import Icon from '../ui/Icon.astro';
import { proofPoints } from '../../data/features';
import { site } from '../../data/site';

const surfaces = ['Theme app extension', 'Web pixel', 'Shopify Flow', 'Shopify segments', 'Shopify discounts'];
---

<section aria-label="Uppush at a glance" class="border-y border-line bg-surface">
  <div class="container-page flex flex-col gap-6 py-8">
    <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4 lg:gap-10">
      <div>
        <dt class="sr-only">App Store rating</dt>
        <dd class="num flex items-center gap-1.5 font-mono text-2xl font-semibold">
          {site.rating}<Icon name="star" size={18} class="fill-current text-signal" />
        </dd>
        <dd class="mt-1 text-xs text-muted">{site.reviewCount} App Store reviews</dd>
      </div>
      {
        proofPoints.map((point) => (
          <div>
            <dt class="sr-only">{point.label}</dt>
            <dd class="num font-mono text-2xl font-semibold">{point.value}</dd>
            <dd class="mt-1 text-xs text-muted">{point.label}</dd>
          </div>
        ))
      }
    </dl>
    <div class="flex flex-wrap items-center gap-2 border-t border-line pt-6">
      {
        site.builtForShopify && (
          <span class="mr-2 inline-flex items-center gap-1.5 rounded-full bg-fg px-3 py-1 text-xs font-semibold text-bg">
            <Icon name="badge-check" size={13} /> Built for Shopify
          </span>
        )
      }
      <span class="mr-1 font-mono text-xs tracking-[0.12em] text-muted uppercase">Built on</span>
      {
        surfaces.map((name) => (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-xs font-medium">
            <Icon name="check" size={12} strokeWidth={2.5} class="text-accent" />
            {name}
          </span>
        ))
      }
    </div>
  </div>
</section>
