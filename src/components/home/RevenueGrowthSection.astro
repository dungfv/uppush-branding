---
/**
 * "Revenue generated for merchants" growth chart, from src/data/growth-stats.json.
 *
 * Only real numbers may be published: production builds render nothing until the file
 * has `verified: true` (fill it with scripts/revenue-stats.mongo.js). In `astro dev`
 * the section shows with a SAMPLE watermark so the design can be reviewed.
 */
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import stats from '../../data/growth-stats.json';

const show = stats.verified || import.meta.env.DEV;
const months = stats.months;
// Dev preview curve when the file still holds zeros (never shipped: see `show`).
const preview = [18, 24, 41, 33, 39, 47, 55, 61, 72, 80, 93, 108].map((v) => v * 982);
const values = months.map((m, i) => (stats.verified ? m.revenue : m.revenue || preview[i % preview.length]));
const orders = months.map((m, i) => (stats.verified ? m.orders : m.orders || Math.round(values[i] / 62)));
const total = values.reduce((a, b) => a + b, 0);
const totalOrders = orders.reduce((a, b) => a + b, 0);
const growth = values[0] ? Math.round(((values.at(-1)! - values[0]) / values[0]) * 100) : 0;

const money = (n: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: stats.currency, notation: n >= 100000 ? 'compact' : 'standard', maximumFractionDigits: n >= 100000 ? 1 : 0 }).format(n);
const monthLabel = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleString('en-US', { month: 'short', timeZone: 'UTC' });

const W = 720, H = 280, PL = 8, PR = 8, PT = 20, PB = 30;
const max = Math.max(...values) * 1.12 || 1;
const bw = (W - PL - PR) / values.length;
const x = (i: number) => PL + bw * i + bw / 2;
const y = (v: number) => PT + (1 - v / max) * (H - PT - PB);
const line = values.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');
---

{
  show && (
    <section aria-labelledby="growth-title" class="relative overflow-hidden bg-ink py-24 text-on-ink sm:py-32">
      <div class="bg-grid-ink pointer-events-none absolute inset-0" aria-hidden="true" />
      {!stats.verified && (
        <p class="absolute top-4 left-1/2 z-10 -translate-x-1/2 rounded-full bg-warn px-3 py-1 font-mono text-xs font-semibold text-ink">
          SAMPLE DATA — dev preview only, hidden in production until growth-stats.json is verified
        </p>
      )}
      <div class="container-page relative">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading
            id="growth-title"
            onInk
            eyebrow="Proven results"
            title="Revenue our merchants earned with Uppush — and it keeps growing."
            lead={`${stats.label}, attributed to Uppush campaigns and automations over the last ${months.length} months.`}
          />
          <dl class="grid shrink-0 grid-cols-3 gap-6 lg:gap-10">
            <div>
              <dt class="text-xs text-on-ink-muted">Revenue generated</dt>
              <dd class="num mt-1 font-mono text-3xl font-semibold text-signal">{money(total)}</dd>
            </div>
            <div>
              <dt class="text-xs text-on-ink-muted">Orders recovered & driven</dt>
              <dd class="num mt-1 font-mono text-3xl font-semibold">{new Intl.NumberFormat('en-US', { notation: totalOrders >= 10000 ? 'compact' : 'standard' }).format(totalOrders)}</dd>
            </div>
            <div>
              <dt class="text-xs text-on-ink-muted">Growth, first → last month</dt>
              <dd class="num mt-1 inline-flex items-center gap-1 font-mono text-3xl font-semibold">
                <Icon name="trending-down" size={22} class="-scale-y-100 text-signal" />{growth}%
              </dd>
            </div>
          </dl>
        </div>

        <figure class="mt-14 rounded-[1.25rem] border border-ink-line bg-ink-2 p-4 sm:p-6">
          <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-labelledby="growth-desc">
            <desc id="growth-desc">{months.map((m, i) => `${monthLabel(m.month)}: ${money(values[i])}`).join(', ')}</desc>
            <defs>
              <linearGradient id="growth-bar" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#15b27a" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#15b27a" stop-opacity="0.15" />
              </linearGradient>
            </defs>
            {values.map((v, i) => (
              <g>
                <rect class="growth-bar" style={`--i:${i}`} x={x(i) - bw * 0.32} y={y(v)} width={bw * 0.64} height={H - PB - y(v)} rx="6" fill="url(#growth-bar)" />
                <text x={x(i)} y={H - 10} text-anchor="middle" class="fill-on-ink-muted font-mono text-[10px]">{monthLabel(months[i].month)}</text>
              </g>
            ))}
            <path d={line} fill="none" stroke="#fafafa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 5" opacity="0.6" />
            <circle cx={x(values.length - 1)} cy={y(values.at(-1)!)} r="6" fill="#15b27a" stroke="#0a0a0a" stroke-width="3" />
            <text x={x(values.length - 1)} y={y(values.at(-1)!) - 14} text-anchor="end" class="fill-signal font-mono text-[12px] font-semibold">{money(values.at(-1)!)}</text>
          </svg>
          <figcaption class="mt-3 font-mono text-[0.6875rem] text-on-ink-muted">
            Orders with revenue attributed to an Uppush campaign or automation, test and cancelled orders excluded. Amounts in {stats.currency}.
          </figcaption>
        </figure>
      </div>
    </section>
  )
}

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .growth-bar {
        transform-box: fill-box;
        transform-origin: bottom;
        animation: grow linear both;
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 3%) entry 100%;
      }
    }
  }
  @keyframes grow {
    from {
      transform: scaleY(0.05);
      opacity: 0.3;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
</style>
