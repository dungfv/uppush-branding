---
/**
 * Link styled as a button. Variants:
 * - primary: signal-green CTA (install / trial)
 * - ink: solid near-black, for light surfaces next to a primary
 * - secondary: outlined, adapts to light/dark
 * - on-ink: outlined for use on dark ink bands
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'ink' | 'secondary' | 'on-ink';
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName;
  external?: boolean;
}

const { href, variant = 'primary', size = 'md', icon, external = false, class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-signal text-on-signal hover:bg-signal-strong shadow-[inset_0_-2px_0_rgb(0_0_0/0.12)]',
  ink: 'bg-fg text-bg hover:opacity-90',
  secondary: 'bg-surface text-fg ring-1 ring-line-strong hover:ring-fg/40',
  'on-ink': 'text-on-ink ring-1 ring-white/20 hover:bg-white/10 hover:ring-white/40',
};
const sizes = {
  sm: 'h-9 px-3.5 text-sm',
  md: 'h-10 px-4 text-sm',
  lg: 'h-12 px-5 text-[0.9375rem]',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2 rounded-full font-semibold whitespace-nowrap transition-[background-color,opacity,box-shadow] duration-150',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
  {...rest}
>
  <slot />
  {
    icon && (
      <Icon
        name={icon}
        size={size === 'lg' ? 18 : 16}
        strokeWidth={2}
        class="transition-transform duration-150 group-hover:translate-x-0.5"
      />
    )
  }
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
