---
/**
 * /about/ — company page (E-E-A-T): who builds Uppush, what it has shipped and how to reach us.
 * Facts only: App Store listing (launch date, developer, address, rating, Built for Shopify,
 * other apps — src/data/site.json), dated feature announcements on the blog, blog authors.
 * No invented headcount, founding year or customer numbers.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { appStoreUrl, site } from '../data/site';
import { automations } from '../data/features';
import { testimonials } from '../data/testimonials';
import { getPublishedPosts, postUrl } from '../lib/blog-posts';
import { absoluteUrl, breadcrumbSchema } from '../lib/json-ld-schema-builders';

const posts = await getPublishedPosts();
const bySlug = (slug: string) => {
  const post = posts.find((p) => p.id === slug);
  if (!post) throw new Error(`about: unknown post ${slug}`);
  return post;
};
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

// Milestones: the App Store launch, then dated announcement posts.
const milestones = [
  ...(site.launchDate
    ? [{ date: site.launchDate, title: 'Launched on the Shopify App Store', body: 'Uppush starts with web push notifications and automations for Shopify stores.', href: undefined as string | undefined }]
    : []),
  ...[
    ['exciting-news-uppush-introduces-flexible-usage-based-pricing', 'Email marketing and pay-as-you-send pricing', 'Email campaigns and automations join web push, with usage-based pricing instead of per-contact plans.'],
    ['introducing-blocked-email-domains-in-uppush', 'Blocked email domains', 'Stop sending to risky domains to protect your sender reputation.'],
    ['introducing-email-list-cleaning-in-uppush', 'Email list cleaning', 'Detect and remove invalid addresses before they hurt deliverability.'],
    ['automate-your-marketing-for-free', 'Core automations free for every store', 'Welcome, abandoned cart and back in stock flows on the Free plan.'],
    ['how-to-warm-your-sending-domain-in-uppush-2', 'Guided domain warm-up', 'Ramp up sending volume on a new domain safely, step by step.'],
  ].map(([slug, title, body]) => ({ date: bySlug(slug).data.pubDate, title, body, href: postUrl(slug) })),
].sort((a, b) => a.date.valueOf() - b.date.valueOf());

const authors = [...posts.reduce((m, p) => m.set(p.data.author, (m.get(p.data.author) ?? 0) + 1), new Map<string, number>())].sort(
  (a, b) => b[1] - a[1],
);

const facts: { value: string; label: string }[] = [
  { value: `${site.rating}★`, label: `${site.reviewCount} App Store reviews` },
  ...(site.builtForShopify ? [{ value: 'Built for Shopify', label: 'Shopify’s highest app standard' }] : []),
  ...(site.launchDate ? [{ value: 'June 2023', label: 'on the Shopify App Store since' }] : []),
  { value: String(automations.length), label: 'automations, pre-written' },
];

const principles: { icon: IconName; title: string; body: string }[] = [
  { icon: 'dollar', title: 'Fair pricing', body: 'You should pay for the value you get — the messages you send — not for the size of your list. That’s why every plan has unlimited subscribers.' },
  { icon: 'zap', title: 'Automation first', body: 'Small teams don’t have time for marketing busywork. Our flows come pre-written, so recovering sales starts on day one.' },
  { icon: 'store', title: 'Shopify only', body: 'We build exclusively for Shopify, on Shopify’s own extension points, so Uppush fits your store instead of fighting it.' },
  { icon: 'chat', title: 'Real support', body: 'Merchants talk to people who know the product. Many of our features started as a support conversation.' },
];

const quotes = testimonials.filter((t) => ['Hoarding Warehouse', 'Zendure France', 'Barista och Espresso'].includes(t.store)).slice(0, 2);
const supportQuote = quotes.find((q) => q.store === 'Zendure France') ?? testimonials[testimonials.length - 1];
---

<BaseLayout
  fullTitle="About Uppush: AI Email Marketing & Web Push for Shopify"
  description="Uppush builds AI email marketing and web push for Shopify from Hanoi, Vietnam. On the App Store since 2023, rated 4.9 and Built for Shopify."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      url: absoluteUrl('/about/'),
      name: 'About Uppush',
      about: { '@id': `${site.url}/#organization` },
    },
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <PageHeader
    eyebrow="About Uppush"
    title="We help independent Shopify stores sell more, <span class='text-accent'>automatically.</span>"
    lead="Uppush is an AI marketing app for Shopify. We give growing stores the email and web push automation big brands use — without the big-brand price tag, and without a marketing team."
  />

  <section aria-label="Uppush in numbers" class="container-page mt-14">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[1.25rem] border border-line bg-line lg:grid-cols-4">
      {
        facts.map((f) => (
          <div class="bg-surface p-6">
            <dt class="text-sm text-muted">{f.label}</dt>
            <dd class="mt-2 font-mono text-2xl font-semibold tracking-tight sm:text-3xl">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Story -->
  <section aria-labelledby="story-title" class="container-page grid gap-12 py-20 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <div>
      <SectionHeading id="story-title" eyebrow="Our story" title="From web push app to AI marketing platform." />
      <div class="mt-6 space-y-4 text-[1.0625rem] leading-relaxed text-muted">
        <p>
          Uppush launched on the Shopify App Store{site.launchDate && ` in ${month(site.launchDate)}`} with one goal: help
          stores bring back shoppers who leave without buying. We started with web push notifications — the fastest way to
          reach a shopper who never left an email address.
        </p>
        <p>
          Merchants asked for more, and we listened. Email marketing arrived with a pricing model we still believe in: pay
          for the messages you send, never for the size of your list. Deliverability tools, AI writing and translation, A/B
          testing and a campaign calendar followed.
        </p>
        <p>
          Today Uppush is {site.builtForShopify ? 'Built for Shopify — Shopify’s highest standard for app performance, design and integration — and ' : ''}rated {site.rating} by merchants on the App Store.
        </p>
      </div>
    </div>

    <ol class="relative space-y-6 before:absolute before:top-2 before:bottom-2 before:left-[0.4375rem] before:w-px before:bg-line-strong" aria-label="Milestones">
      {
        milestones.map((m) => (
          <li class="relative pl-8">
            <span class="absolute top-1.5 left-0 size-[0.9375rem] rounded-full border-2 border-signal bg-bg" aria-hidden="true" />
            <p class="font-mono text-xs tracking-wider text-muted uppercase"><time datetime={m.date.toISOString().slice(0, 10)}>{month(m.date)}</time></p>
            <h3 class="mt-1 font-semibold tracking-tight">{m.href ? <a href={m.href} class="hover:text-accent">{m.title}</a> : m.title}</h3>
            <p class="mt-1 text-sm text-muted">{m.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Principles -->
  <section aria-labelledby="principles" class="border-y border-line bg-surface py-20">
    <div class="container-page">
      <SectionHeading id="principles" eyebrow="What we believe" title="Four principles behind every feature." />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {
          principles.map((p) => (
            <li class="rounded-(--radius-card) border border-line bg-bg p-7">
              <Icon name={p.icon} size={22} class="text-accent" />
              <h3 class="mt-4 text-lg font-semibold">{p.title}</h3>
              <p class="mt-1.5 leading-relaxed text-muted">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- People -->
  <section aria-labelledby="people-title" class="container-page grid gap-12 py-20 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading
        id="people-title"
        eyebrow="The people behind Uppush"
        title="A product team in Hanoi, Vietnam."
        lead="Uppush is designed, built and supported by the same team. When you open a chat, you talk to people who know the product and can pass your feedback straight to the people who build it."
      />
      <figure class="mt-8 rounded-(--radius-card) border border-line bg-surface p-6">
        <blockquote class="text-[0.9375rem] leading-relaxed">“{supportQuote.quote}”</blockquote>
        <figcaption class="mt-4 text-sm text-muted"><span class="font-semibold text-fg">{supportQuote.store}</span> · {supportQuote.country}, Shopify App Store review</figcaption>
      </figure>
    </div>
    <div class="space-y-4">
      <div class="rounded-(--radius-card) border border-line bg-surface p-6">
        <h3 class="flex items-center gap-2 font-semibold"><Icon name="book" size={18} class="text-accent" /> Who writes our blog</h3>
        <p class="mt-2 text-sm text-muted">Guides on Shopify email marketing, web push and cart recovery, written from what we see across the stores we support.</p>
        <ul class="mt-4 divide-y divide-line">
          {
            authors.map(([name, count]) => (
              <li class="flex items-center justify-between py-2.5 text-sm">
                <span class="flex items-center gap-2.5">
                  <span class="grid size-8 place-items-center rounded-full bg-signal-soft text-xs font-semibold text-accent" aria-hidden="true">{name.charAt(0)}</span>
                  {name}
                </span>
                <span class="font-mono text-xs text-muted">{count} articles</span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        site.otherApps.length > 0 && (
          <div class="rounded-(--radius-card) border border-line bg-surface p-6">
            <h3 class="flex items-center gap-2 font-semibold"><Icon name="store" size={18} class="text-accent" /> Also by our team</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {site.otherApps.map((a) => (
                <li>
                  <a href={a.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-accent hover:underline">
                    {a.name} <Icon name="external" size={13} />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Company details -->
  <section aria-labelledby="reach" class="container-page">
    <div class="grid gap-8 rounded-[1.75rem] bg-ink p-8 text-on-ink sm:p-12 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow text-signal">Company</p>
        <h2 id="reach" class="mt-4 text-3xl font-semibold">Talk to the team.</h2>
        <div class="mt-6">
          <ButtonLink href={appStoreUrl('about_cta')} external icon="arrow-right">Install Uppush free</ButtonLink>
        </div>
      </div>
      <dl class="grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-on-ink-muted">Support</dt>
          <dd class="mt-1"><a href={`mailto:${site.supportEmail}`} class="font-medium hover:text-signal">{site.supportEmail}</a></dd>
        </div>
        <div>
          <dt class="text-sm text-on-ink-muted">Partnerships</dt>
          <dd class="mt-1"><a href={`mailto:${site.partnerEmail}`} class="font-medium hover:text-signal">{site.partnerEmail}</a></dd>
        </div>
        {
          site.address && (
            <div>
              <dt class="text-sm text-on-ink-muted">Address</dt>
              <dd class="mt-1 font-medium">
                <address class="not-italic">{site.address.street}, {site.address.city} {site.address.postalCode}, Vietnam</address>
              </dd>
            </div>
          )
        }
        <div>
          <dt class="text-sm text-on-ink-muted">Shopify App Store</dt>
          <dd class="mt-1">
            <a href={appStoreUrl('about_cta')} target="_blank" rel="noopener" class="font-medium hover:text-signal">{site.appStoreName}<span class="sr-only"> (opens in a new tab)</span></a>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
