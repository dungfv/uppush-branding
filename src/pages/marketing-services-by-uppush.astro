---
/** /marketing-services-by-uppush/ — done-for-you email marketing service run by the Uppush team. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/json-ld-schema-builders';

const benefits: { icon: IconName; title: string; points: string[] }[] = [
  { icon: 'timer', title: 'Save time & effort', points: ['No setup or daily management', 'No learning curve'] },
  { icon: 'inbox', title: 'Better deliverability', points: ['Inbox placement optimised', 'Healthy sending practices', 'Domain reputation protected'] },
  { icon: 'chart-line', title: 'Stronger performance', points: ['Higher open rates', 'Better click-through', 'More engagement'] },
  { icon: 'filter', title: 'A clean list', points: ['Low-quality contacts removed', 'A high-performing audience'] },
  { icon: 'dollar', title: 'Lower costs', points: ['Send to contacts that convert', 'No money wasted on inactive users'] },
  { icon: 'workflow', title: 'Smart automation', points: ['High-converting flows: cart, browse, welcome…', 'Tailored to your store'] },
  { icon: 'chart', title: 'Clear reporting', points: ['Weekly performance updates', 'Monthly reports'] },
  { icon: 'code', title: 'Technical support', points: ['Storefront optimisation help if needed (may be charged)'] },
];

const steps = [
  {
    title: 'Deep dive into your business',
    lead: 'We start with understanding, not tools.',
    points: ['Analyse your store, products and current performance', 'Identify audience segments and buying behaviour', 'Review existing channels and gaps', 'Agree KPIs: revenue, conversion rate, retention'],
  },
  {
    title: 'Build a conversion-focused strategy',
    lead: 'A complete growth system, not random campaigns.',
    points: ['Lifecycle flows: abandoned cart, browse, checkout recovery', 'Campaign calendar: promotions, seasonal pushes, drops', 'Popups, spin wheels and lead capture', 'Messaging tailored to your audience'],
  },
  {
    title: 'You approve before anything goes live',
    lead: 'You stay in control without the heavy lifting.',
    points: ['Review flows, emails and popups', 'We adjust to your feedback', 'Align on branding, tone and offers'],
  },
  {
    title: 'Full execution, done for you',
    lead: 'We handle everything inside Uppush.',
    points: ['Launch all flows and campaigns', 'Design emails and popups', 'Configure targeting and triggers', 'Monitor performance daily'],
  },
  {
    title: 'Continuous optimisation',
    lead: 'Where real growth happens.',
    points: ['Tune send timing and segmentation', 'Improve conversion over time', 'Scale what works, cut what doesn’t'],
  },
  {
    title: 'Transparent reporting',
    lead: 'You always know what’s going on.',
    points: ['Weekly activity updates', 'Monthly performance breakdown', 'Clear recommendations for next steps'],
  },
];
---

<BaseLayout
  fullTitle="Done-for-You Shopify Email Marketing Service | Uppush"
  description="Let the Uppush team run your Shopify email marketing: strategy, flows, campaigns, popups and reporting — done for you, with your approval."
  cta={false}
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Marketing services', path: '/marketing-services-by-uppush/' },
    ]),
  ]}
>
  <PageHeader
    eyebrow="Managed service"
    title="Done-for-you email marketing. <span class='text-accent'>Zero effort.</span>"
    lead="Our team becomes your email marketing team: we set up Uppush, build and run your flows and campaigns, and keep improving them — while you focus on your store."
  >
    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <ButtonLink href="/contact/?topic=managed-service" size="lg" icon="arrow-right">Talk to our team</ButtonLink>
      <ButtonLink href="#how" variant="secondary" size="lg">How it works</ButtonLink>
    </div>
    <ul class="mx-auto mt-10 flex max-w-2xl flex-col justify-center gap-x-6 gap-y-2 text-sm text-muted sm:flex-row">
      {
        ['No email marketing to learn', 'No tools to manage', 'No guessing what works'].map((t) => (
          <li class="inline-flex items-center justify-center gap-1.5">
            <Icon name="check" size={16} strokeWidth={2.25} class="text-accent" />
            {t}
          </li>
        ))
      }
    </ul>
  </PageHeader>

  <section aria-labelledby="benefits-title" class="container-page py-24 sm:py-32">
    <SectionHeading
      id="benefits-title"
      eyebrow="What you get"
      title="Email marketing is powerful. Doing it right is hard."
      lead="So we do it for you — with a team that combines e-commerce marketing experience and deep knowledge of the Uppush platform."
    />
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((b) => (
          <li class="rounded-(--radius-card) border border-line bg-surface p-6">
            <Icon name={b.icon} size={22} class="text-accent" />
            <h3 class="mt-4 font-semibold tracking-tight">{b.title}</h3>
            <ul class="mt-2 space-y-1 text-sm text-muted">
              {b.points.map((p) => <li>{p}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="how" aria-labelledby="how-title" class="scroll-mt-20 bg-ink py-24 text-on-ink sm:py-32">
    <div class="container-page">
      <SectionHeading
        id="how-title"
        onInk
        eyebrow="How it works"
        title="From understanding your business to growing it, month after month."
      />
      <ol class="mt-14 grid gap-px overflow-hidden rounded-[1.25rem] border border-ink-line bg-ink-line md:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="bg-ink-2 p-7">
              <span class="font-mono text-sm text-signal">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
              <p class="mt-1 text-sm text-on-ink-muted">{s.lead}</p>
              <ul class="mt-4 space-y-2 text-sm">
                {s.points.map((p) => (
                  <li class="flex gap-2">
                    <Icon name="check" size={15} strokeWidth={2.25} class="mt-0.5 shrink-0 text-signal" />
                    {p}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="svc-cta" class="container-page py-24 text-center sm:py-32">
    <p class="eyebrow">Get started</p>
    <h2 id="svc-cta" class="mx-auto mt-4 max-w-2xl text-4xl leading-tight font-semibold sm:text-5xl">
      Stop managing emails. Start generating revenue.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-muted">
      You don’t need a bigger team — you need the right system and the right people behind it. Tell us about your store and
      we’ll propose a plan.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <ButtonLink href="/contact/?topic=managed-service" size="lg" icon="arrow-right">Talk to our team</ButtonLink>
      <ButtonLink href={`mailto:${site.partnerEmail}`} variant="secondary" size="lg">{site.partnerEmail}</ButtonLink>
    </div>
  </section>
</BaseLayout>
