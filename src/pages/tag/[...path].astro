---
/**
 * Tag archives at their WordPress URLs: /tag/email-marketing/, paginated /tag/email-marketing/page/2/.
 * Only tags with MIN_ARCHIVE_POSTS+ posts are built; thin ones 301 to /blog/ (docs/url-inventory.csv).
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListingView from '../../components/blog/BlogListingView.astro';
import { getArchiveCategories, getArchiveTags, getPublishedPosts, paginateWp, slugifyTag, tagUrl, type PostPage } from '../../lib/blog-posts';
import { breadcrumbSchema } from '../../lib/json-ld-schema-builders';
import taxonomySeo from '../../data/taxonomy-seo.json';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const categories = getArchiveCategories(posts);
  return getArchiveTags(posts).flatMap((tag) =>
    paginateWp(
      posts.filter((post) => post.data.tags.some((name) => slugifyTag(name) === tag.slug)),
      tagUrl(tag.name),
      tag.slug,
    ).map(({ param, page }) => ({ params: { path: param }, props: { page, tag, categories } })),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: PostPage;
  tag: { name: string; slug: string; count: number };
  categories: ReturnType<typeof getArchiveCategories>;
}

const { page, tag, categories } = Astro.props;
const name = tag.name.charAt(0).toUpperCase() + tag.name.slice(1);
const seo = (taxonomySeo as Record<string, { title: string; description: string }>)[`tag/${tag.slug}`];
const pageSuffix = page.currentPage > 1 ? ` – Page ${page.currentPage}` : '';
---

<BaseLayout
  title={(seo?.title ?? `${name} articles`) + pageSuffix}
  description={(page.currentPage > 1 ? `Page ${page.currentPage}: ` : '') + (seo?.description ?? `Articles about ${tag.name} for Shopify merchants, from the Uppush blog.`)}
  noindex
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name, path: tagUrl(tag.name) },
    ]),
  ]}
>
  <BlogListingView page={page} title={name} eyebrow="Topic" lead={`${tag.count} articles tagged “${tag.name}”.`} categories={categories} />
</BaseLayout>
